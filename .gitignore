# Build artifacts
/publicvpn
/dist/

# Local scratch (never committed)
*.tmp-*
*.log

# Operational pipeline config (owner-private; sanitized template = config.example.toml)
/config.toml

# OS noise
.DS_Store

# Editor crash snapshots (unsaved-buffer dumps like client.go.1234567890)
*.go.[0-9]*

# Lua plugins: bundled defaults + any runtime-generated plugin files
internal/plugins/defaults/*.lua
*.lua

# Superpowers SDD session state (agent tooling, never committed)
/.superpowers/
