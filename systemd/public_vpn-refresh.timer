[Unit]
Description=publicvpn refresh wave timer (configured recheck period, catch-up on wake)

[Timer]
# Recheck period from [maintain].refresh_interval, rendered by
# `publicvpn install`. OnUnitActiveSec re-arms the timer N after each
# COMPLETED run, so waves never overlap and arbitrary durations (90m, 6h,
# 10d) are supported — OnCalendar cannot express a config-driven interval.
# OnBootSec fires the first wave shortly after boot.
OnBootSec=2min
OnUnitActiveSec={{ .RefreshInterval }}
# Replay a missed wave after the machine wakes from sleep or boots late.
Persistent=true
Unit=public_vpn-refresh.service

[Install]
WantedBy=timers.target
