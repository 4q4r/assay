[Unit]
Description=publicvpn speedtest wave timer (configured recheck period, catch-up on wake)

[Timer]
# Recheck period from [maintain].speedtest_interval (default 168h = weekly),
# rendered by `publicvpn install` — same OnBootSec/OnUnitActiveSec mechanics
# as the refresh timer. Staggered 20min boot delay so the boot waves do not
# stampede the probe origin (the refresh wave fires first at 2min).
OnBootSec=20min
OnUnitActiveSec={{ .SpeedtestInterval }}
Persistent=true
Unit=public_vpn-speedtest.service

[Install]
WantedBy=timers.target
