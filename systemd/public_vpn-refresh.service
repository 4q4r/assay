[Unit]
Description=publicvpn refresh wave (fetch/parse/filter/probe/geo/stats/prune/select/render/activate-if-changed)

[Service]
Type=oneshot
# The wave reuses the pipeline config file (single source of truth, no env
# vars). Rendered by `publicvpn install` from this template — do not edit the
# installed copy by hand; change [maintain].refresh_interval and re-run
# install instead.
ExecStart={{ .BinaryPath }} maintain -c {{ .ConfigPath }}
# A wave touches the network (sources, probes) and the live xray config only
# through the -test gate; it never restarts the client — the binary prints
# the restart hint for the owner instead.
