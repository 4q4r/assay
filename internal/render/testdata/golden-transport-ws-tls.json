{
  "api": {
    "services": [
      "StatsService"
    ],
    "tag": "api"
  },
  "burstObservatory": {
    "pingConfig": {
      "connectivity": "http://1.0.0.1/cdn-cgi/trace",
      "destination": "http://1.1.1.1/cdn-cgi/trace",
      "httpMethod": "GET",
      "interval": "10s",
      "sampling": 5,
      "timeout": "3s"
    },
    "subjectSelector": [
      "proxy-"
    ]
  },
  "dns": {
    "queryStrategy": "UseIPv4",
    "servers": [
      "https://dns.google/dns-query"
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true
      },
      "tag": "socks-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "enabled": true,
        "routeOnly": true
      },
      "tag": "http-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 15490,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api-in"
    }
  ],
  "log": {
    "dnsLog": false,
    "loglevel": "warning"
  },
  "observatory": {
    "enableConcurrency": true,
    "probeInterval": "60s",
    "subjectSelector": [
      "pool-"
    ]
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs"
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      },
      "tag": "block"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "198.51.100.1",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "id": "00000000-0000-0000-0000-000000000001"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "realitySettings": {
          "fingerprint": "firefox",
          "publicKey": "QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE",
          "serverName": "donor.example",
          "shortId": "AA"
        },
        "security": "reality",
        "sockopt": {
          "tcpMaxSeg": 1440
        }
      },
      "tag": "proxy-0"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "198.51.100.2",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "id": "00000000-0000-0000-0000-000000000001"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "realitySettings": {
          "fingerprint": "firefox",
          "publicKey": "QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE",
          "serverName": "donor.example",
          "shortId": "AA"
        },
        "security": "reality",
        "sockopt": {
          "tcpMaxSeg": 1440
        }
      },
      "tag": "proxy-1"
    },
    {
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "node1.example.com",
            "password": "pool-uuid-1",
            "port": 443
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "sockopt": {
          "tcpMaxSeg": 1440
        },
        "tlsSettings": {
          "fingerprint": "firefox",
          "serverName": "donor.example"
        },
        "wsSettings": {
          "host": "ws.example",
          "path": "/tj?ed=2048"
        }
      },
      "tag": "pool-nl-01"
    }
  ],
  "policy": {
    "system": {
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "balancers": [
      {
        "fallbackTag": "proxy-0",
        "selector": [
          "proxy-"
        ],
        "strategy": {
          "settings": {
            "expected": 1,
            "maxRTT": "1s",
            "tolerance": 0.2
          },
          "type": "leastLoad"
        },
        "tag": "best_rtt"
      },
      {
        "selector": [
          "pool-nl-"
        ],
        "strategy": {
          "settings": {
            "expected": 1,
            "tolerance": 0.2
          },
          "type": "leastLoad"
        },
        "tag": "pool_nl"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "api-in"
        ],
        "outboundTag": "api",
        "type": "field"
      },
      {
        "domain": [
          "domain:nvidia.com"
        ],
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "outboundTag": "fox-proxy",
        "type": "field"
      },
      {
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "outboundTag": "block",
        "port": "25,465,587,2525",
        "type": "field"
      },
      {
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "outboundTag": "direct",
        "protocol": [
          "bittorrent"
        ],
        "type": "field"
      },
      {
        "domain": [
          "geosite:youtube"
        ],
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "domain": [
          "domain:example.ru"
        ],
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "balancerTag": "best_rtt",
        "inboundTag": [
          "socks-in",
          "http-in"
        ],
        "network": "tcp,udp",
        "type": "field"
      }
    ]
  },
  "stats": {}
}